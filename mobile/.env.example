# Copy to mobile/.env.local (git-ignored). All three are PUBLIC values — the anon key is designed
# to ship in a client; the API is the fence (_current_identity()).
EXPO_PUBLIC_API_URL=https://meyy-api.onrender.com
# For the Mac's dev API over WiFi instead: the LAN IP `ipconfig getifaddr en0` gives, port 8000.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>

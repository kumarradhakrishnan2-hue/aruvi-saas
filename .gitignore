# ── Secrets — never back these up to a remote ──
.env
*.key

# ── Regenerable / reinstallable — excluded from backup by design ──
# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
# Web build output + dependencies (recreate with `npm install` / `next build`)
web/.next/
web/node_modules/
web/out/
# Test/render artifacts (regenerated by tests/test_render.py) — ROOT out/ only, anchored
# so it no longer swallows genon/out/ (see the genon rule below).
/out/

# ── genon run artifacts (rule set 2026-07-26) ──
# genon/out/ is the generation scratch. Two of its three artifact types are dead weight
# once a canonical is certified and deployed: the prompt dump is regenerable with --dry,
# and the parsed _canonical.json is a duplicate of the certified file in
# data/content/saved_plans/. The RAW model reply is kept and TRACKED: it is the only
# evidence that an auto-repair (naked-quote escaping) changed nothing but escapes, and it
# cannot be reconstructed from anything else. ~44 KB gzipped per run — the whole portfolio
# is well under 40 MB. Permanent run record stays genon/ledger.csv; per-plan provenance
# stays in the canonical's own genon_canonical block.
genon/out/**/*_promptdump.json
genon/out/**/*_canonical.json
genon/out/polish_tests/
# OS / temp
.DS_Store
*.tmp

# ── Large source assets — excluded from git (too big; keep a separate local backup) ──
# Textbook PDFs (~1.5 GB). Authoring source only; do NOT commit.
/textbooks/

# NOTE: everything under data/ (constitutions, chapters, framework, saved plans, and
# per-user/tenant runtime state) is now TRACKED so GitHub Desktop backs it up. Only
# /textbooks/ and the regenerable/secret items above are excluded.

# dev launcher logs
.devlogs/
